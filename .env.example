# Free local AI via Ollama (no API key needed).
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b

# Models offered in the Model dropdown (first = default). Pull each with: ollama pull <name>
AI_MODELS=qwen2.5:7b,qwen2.5:3b

# Any OpenAI-compatible service also works, for example Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=your_api_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Change this before deploying publicly.
SECRET_KEY=replace-this-with-a-long-random-secret
